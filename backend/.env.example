# Copy and configure manually. Never commit production credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-your-own-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave POSTGRES_DB unset for the initial SQLite local setup.
# POSTGRES_DB=movego
# POSTGRES_USER=movego
# POSTGRES_PASSWORD=choose-a-strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
